# Copie para .env.local (ignorado pelo git) e preencha. Nunca commite valores reais.
# "mock" = modo demo no navegador; "supabase" = banco de verdade.
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Conferência de comprovantes por IA (só no servidor; nunca com prefixo NEXT_PUBLIC_).
# Sem elas o app funciona igual, só sem a leitura automática dos Pix.
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública (canonical, sitemap, links do MCP). Em produção: https://bolaodamega.avaaraujo.com
NEXT_PUBLIC_SITE_URL=
